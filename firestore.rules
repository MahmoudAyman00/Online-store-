rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // دور الأدمن: الأساس Custom Claims (request.auth.token.admin).
    // الشرط الثاني (role من Firestore) للفترة الانتقالية فقط حتى يحصل كل
    // الأدمنز على Claims عبر setAdminRole/bootstrap — احذفه بعدها.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/Users\ Collection/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function existingRole(uid) {
      return get(/databases/$(database)/documents/Users\ Collection/$(uid)).data.role;
    }

    // ---------- Users Collection (لاحظ المسافة في الاسم — لا تغيرها قبل Migration) ----------
    match /Users\ Collection/{uid} {
      // القراءة: صاحب الحساب أو الأدمن
      allow read: if isOwner(uid) || isAdmin();
      // الإنشاء (Signup): المستخدم ينشئ بروفايله فقط، ودوره لازم user
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.email is string
        && request.resource.data.username is string;
      // التحديث: صاحب الحساب، وممنوع يرفع نفسه لأدمن
      // يسمح بتعديل username/phone/birthDate فقط، role ثابت
      allow update: if (isOwner(uid) || isAdmin())
        && request.resource.data.role == resource.data.role;
      allow delete: if false; // حذف الحسابات عبر Console/Function فقط

      match /Cart/{itemId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if isOwner(uid);
      }

      match /Wishlist/{itemId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if isOwner(uid);
      }
    }

    // ---------- Categories (قراءة عامة، كتابة أدمن فقط) ----------
    match /Categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- products (قراءة عامة، كتابة أدمن فقط) ----------
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Transactions (سجل غير قابل للتعديل) ----------
    // سقف حماية من السبام: max 50 صنف، إجمالي max 500k
    // (الحماية الكاملة ضد السبام تحتاج App Check + Rate limit عبر Functions)
    match /Transactions/{txId} {
      // الإنشاء: مستخدم مسجل، userId يطابق نفسه، items غير فارغة، total > 0
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0
        && request.resource.data.totalPrice <= 500000;
      // القراءة: صاحب الطلب أو الأدمن
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // ---------- Feedbacks ----------
    match /Feedbacks/{fbId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('comment' in request.resource.data)
            || request.resource.data.comment.size() <= 1000);
      // القراءة: الأدمن يشوف الكل، اليوزر يشوف فيدباكه فقط
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
