rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // التطبيق حالياً لا يرفع أي ملف (يستخدم imageUrl نصية فقط) —
    // لذلك نمنع كل كتابة من الكلاينت لمنع ملء الـ Bucket والتكلفة.
    // عند إضافة رفع صور: ارفع عبر Cloud Function/Admin SDK فقط،
    // أو افتح الكتابة بشرط Custom Claim: request.auth.token.admin == true
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
